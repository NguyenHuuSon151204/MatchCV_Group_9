                    margin: 10px 0 5px;
                }
                .title {
                    color: #555;
                    font-size: 15px;
                    margin-bottom: 24px;
                }
                .section {
                    margin-bottom: 20px;
                }
                .section-title {
                    font-weight: 700;
                    margin-bottom: 8px;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #333;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }
                .section-title span {
                    width: 24px;
                    height: 3px;
                    background: #333;
                    display: inline-block;
                    border-radius: 2px;
                }
                .info-item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin-bottom: 8px;
                    color: #444;
                    font-size: 14px;
                }
                .skill-chip {
                    display: inline-block;
                    padding: 8px 12px;
                    background: #f7f7f7;
                    color: #333;
                    border-radius: 12px;
                    margin: 4px;
                    font-size: 12px;
                    font-weight: 600;
                    border: 1px solid #ddd;
                }
                .main h2 {
                    font-size: 24px;
                    margin-bottom: 6px;
                    color: #333;
                }
                .main .subtitle {
                    color: #555;
                    margin-bottom: 18px;
                    font-size: 14px;
                }
                .timeline-item {
                    margin-bottom: 14px;
                }
                .timeline-title {
                    font-weight: 700;
                    color: #333;
                }
                .timeline-meta {
                    font-size: 13px;
                    color: #555;
                    margin: 3px 0;
