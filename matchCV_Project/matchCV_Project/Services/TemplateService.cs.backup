        {
            return @"
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Inter', 'Roboto', sans-serif;
                    background: #ffffff;
                    color: #333;
                }
                .page {
                    display: flex;
                    width: 100%;
                    min-height: 100vh;
                }
                .sidebar {
                    width: 30%;
                    background: #f1f1f1;
                    color: #333;
                    padding: 40px 30px;
                    box-sizing: border-box;
                }
                .main {
                    width: 70%;
                    padding: 40px;
                    box-sizing: border-box;
