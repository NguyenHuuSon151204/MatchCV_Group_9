using ApiRestFul.DTOs;
using ApiRestFul.Services;
using matchCV_Project.Models;
using iText.Html2pdf;
using iText.Kernel.Pdf;
using System.Text;
using System.Web;
using matchCV_Project.Data;
using Microsoft.EntityFrameworkCore;

namespace matchCV_Project.Services
{
    public class TemplateService : ITemplateService
    {
        private readonly AppDbContext _context;

        public TemplateService(AppDbContext context)
        {
            _context = context;
        }

        public async Task<List<CVTemplateDto>> GetAvailableTemplatesAsync()
        {
            var templates = await _context.Cvtemplates
                .Where(t => t.IsActive)
                .OrderBy(t => t.CreatedAt)
                .ToListAsync();

            return templates.Select(t => new CVTemplateDto
            {
                Id = t.Id,
                Key = t.Key,
                Name = t.Name,
                Description = t.Description,
                ThumbnailUrl = t.ThumbnailUrl,
                TemplateType = t.Key // Use Key for type identification
            }).ToList();
        }

        public async Task<byte[]> ExportToPdfAsync(CVDataDto cvData)
        {
            var htmlContent = GenerateHtmlContent(cvData, forPdf: true);

            using (var memoryStream = new MemoryStream())
            {
                HtmlConverter.ConvertToPdf(htmlContent, memoryStream);
                return memoryStream.ToArray();
            }
        }

        public async Task<byte[]> GenerateCVPreviewAsync(CVDataDto cvData)
        {
            var htmlContent = GenerateHtmlContent(cvData, forPdf: false);
            return Encoding.UTF8.GetBytes(htmlContent);
        }

        private string GenerateHtmlContent(CVDataDto cvData, bool forPdf)
        {
            var sb = new StringBuilder();

            sb.AppendLine("<!DOCTYPE html>");
            sb.AppendLine("<html lang='vi'>");
            sb.AppendLine("<head>");
            sb.AppendLine("    <meta charset='UTF-8'>");
            sb.AppendLine("    <meta name='viewport' content='width=device-width, initial-scale=1.0'>");
            sb.AppendLine("    <title>CV - " + HttpUtility.HtmlEncode(cvData.PersonalInfo?.FullName ?? "?ng viě") + "</title>");
            sb.AppendLine("    <link href='https://fonts.googleapis.com/icon?family=Material+Icons' rel='stylesheet'>");
            sb.AppendLine("    <link href='https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700\u0026family=Inter:wght@400;500;600;700\u0026display=swap' rel='stylesheet'>");
            sb.AppendLine("    <style>");

            string templateType = cvData.TemplateType?.ToLower() ?? "professional";

            if (templateType == "modern")
                sb.AppendLine(GetModernStyles());
            else if (templateType == "formal")
                sb.AppendLine(GetFormalStyles());
            else
                sb.AppendLine(GetProfessionalStyles());

            sb.AppendLine("    </style>");
            sb.AppendLine("</head>");
            sb.AppendLine("<body>");

            sb.AppendLine(GenerateTemplate(cvData, templateType, forPdf));

            sb.AppendLine("</body>");
            sb.AppendLine("</html>");

            return sb.ToString();
        }

        #region Template Styles

        private string GetProfessionalStyles()
        {
            return @"
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Inter', 'Roboto', sans-serif;
                    background: #f5f5f5;
                    color: #333;
                }
                .page {
                    display: flex;
                    width: 100%;
                    min-height: 100vh;
                    background: linear-gradient(135deg, #f5f5f5, #eaeaea);
                }
                .sidebar {
                    width: 28%;
                    background: #2b3a67;
                    color: #fff;
                    padding: 40px 30px;
                    box-sizing: border-box;
                }
                .main {
                    width: 72%;
                    padding: 40px;
                    box-sizing: border-box;
                }
                .avatar {
                    width: 110px;
                    height: 110px;
                    border-radius: 50%;
                    overflow: hidden;
                    margin-bottom: 20px;
                    border: 4px solid #4f6bd2;
                }
                .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
                .name {
                    font-size: 30px;
                    font-weight: 700;
                    margin: 10px 0 5px;
                }
                .title {
                    color: #cfd8ff;
                    font-size: 16px;
                    margin-bottom: 30px;
                }
                .section {
                    margin-bottom: 24px;
                }
                .section-title {
                    font-weight: 700;
                    margin-bottom: 10px;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #4f6bd2;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }
                .section-title span {
                    width: 24px;
                    height: 3px;
                    background: #4f6bd2;
                    display: inline-block;
                    border-radius: 2px;
                }
                .info-item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin-bottom: 8px;
                    color: #cfd8ff;
                    font-size: 14px;
                }
                .skill-chip {
                    display: inline-block;
                    padding: 8px 12px;
                    background: #e9eefc;
                    color: #2b3a67;
                    border-radius: 12px;
                    margin: 4px;
                    font-size: 12px;
                    font-weight: 600;
                }
                .main h2 {
                    font-size: 26px;
                    margin-bottom: 6px;
                    color: #2b3a67;
                }
                .main .subtitle {
                    color: #556;
                    margin-bottom: 20px;
                    font-size: 15px;
                }
                .timeline-item {
                    margin-bottom: 16px;
                }
                .timeline-title {
                    font-weight: 700;
                    color: #2b3a67;
                }
                .timeline-meta {
                    font-size: 13px;
                    color: #556;
                    margin: 3px 0;
                }
                .timeline-desc {
                    font-size: 14px;
                    color: #444;
                    margin: 6px 0 0;
                    line-height: 1.6;
                }
            ";
        }

