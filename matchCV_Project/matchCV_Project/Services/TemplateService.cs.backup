        #endregion

        private string GenerateTemplate(CVDataDto cvData, string templateType, bool forPdf)
        {
            var sb = new StringBuilder();

            var personal = cvData.PersonalInfo;
            var experiences = cvData.Experiences ?? new List<ExperienceDto>();
            var educations = cvData.Educations ?? new List<EducationDto>();
            var skills = cvData.Skills ?? new List<SkillDto>();

            sb.AppendLine("<div class='page'>");
            sb.AppendLine("  <div class='sidebar'>");

            if (!string.IsNullOrEmpty(personal?.AvatarBase64))
            {
                sb.AppendLine("    <div class='avatar'>");
                sb.AppendLine($"      <img src='data:image/png;base64,{personal.AvatarBase64}' alt='Avatar' />");
                sb.AppendLine("    </div>");
            }

            sb.AppendLine($"    <div class='name'>{HttpUtility.HtmlEncode(personal?.FullName ?? cvData.FullName ?? "Nguy\u1ec5n V\u0103n A")}</div>");
            sb.AppendLine($"    <div class='title'>{HttpUtility.HtmlEncode(personal?.Position ?? "Chuy\u00ean gia")}</div>");

            sb.AppendLine("    <div class='section'>");
            sb.AppendLine("      <div class='section-title'><span></span>Li\u00ean h\u1ec7</div>");
            if (!string.IsNullOrEmpty(personal?.Email))
                sb.AppendLine($"      <div class='info-item'>Email: {HttpUtility.HtmlEncode(personal.Email)}</div>");
            if (!string.IsNullOrEmpty(personal?.Phone))
                sb.AppendLine($"      <div class='info-item'>Phone: {HttpUtility.HtmlEncode(personal.Phone)}</div>");
            if (!string.IsNullOrEmpty(personal?.Address))
                sb.AppendLine($"      <div class='info-item'>Address: {HttpUtility.HtmlEncode(personal.Address)}</div>");
            if (!string.IsNullOrEmpty(personal?.Website))
                sb.AppendLine($"      <div class='info-item'>Website: {HttpUtility.HtmlEncode(personal.Website)}</div>");
            sb.AppendLine("    </div>");

            if (skills.Any())
            {
                sb.AppendLine("    <div class='section'>");
                sb.AppendLine("      <div class='section-title'><span></span>K\u1ef9 n\u0103ng</div>");
                sb.AppendLine("      <div>");
                foreach (var skill in skills.Take(20))
                {
                    sb.AppendLine($"        <span class='skill-chip'>{HttpUtility.HtmlEncode(skill.Name)}{(string.IsNullOrEmpty(skill.Level) ? "" : " - " + HttpUtility.HtmlEncode(skill.Level))}</span>");
                }
                sb.AppendLine("      </div>");
                sb.AppendLine("    </div>");
            }

            sb.AppendLine("  </div>");
            sb.AppendLine("  <div class='main'>");

            sb.AppendLine("    <div class='section'>");
            sb.AppendLine("      <h2>Gi\u1edbi thi\u1ec7u</h2>");
            sb.AppendLine("      <p class='subtitle'>");
            sb.AppendLine(HttpUtility.HtmlEncode(personal?.Summary ?? cvData.Summary ?? "T\u1ed5ng quan kinh nghi\u1ec7m, th\u00e0nh t\u1ef1u v\u00e0 \u0111\u1ecbnh h\u01b0\u1edbng ngh\u1ec1 nghi\u1ec7p."));
            sb.AppendLine("      </p>");
            sb.AppendLine("    </div>");

            if (experiences.Any())
            {
                sb.AppendLine("    <div class='section'>");
                sb.AppendLine("      <h2>Kinh nghi\u1ec7m</h2>");
                foreach (var exp in experiences.Take(10))
                {
                    sb.AppendLine("      <div class='timeline-item'>");
                    sb.AppendLine($"        <div class='timeline-title'>{HttpUtility.HtmlEncode(exp.Position)}</div>");
                    sb.AppendLine($"        <div class='timeline-meta'>{HttpUtility.HtmlEncode(exp.Company)} | {exp.StartDate?.ToString("MM/yyyy")} - {(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("MM/yyyy") : "Hi\u1ec7n t\u1ea1i")}</div>");
                    if (!string.IsNullOrEmpty(exp.Description))
                        sb.AppendLine($"        <div class='timeline-desc'>{HttpUtility.HtmlEncode(exp.Description)}</div>");
                    sb.AppendLine("      </div>");
                }
                sb.AppendLine("    </div>");
            }

            if (educations.Any())
            {
                sb.AppendLine("    <div class='section'>");
                sb.AppendLine("      <h2>H\u1ecdc v\u1ea5n</h2>");
                foreach (var edu in educations.Take(8))
                {
                    sb.AppendLine("      <div class='timeline-item'>");
                    sb.AppendLine($"        <div class='timeline-title'>{HttpUtility.HtmlEncode(edu.Degree)}</div>");
                    sb.AppendLine($"        <div class='timeline-meta'>{HttpUtility.HtmlEncode(edu.Institution)} | {edu.StartYear} - {edu.EndYear?.ToString() ?? "Nay"}</div>");
                    if (!string.IsNullOrEmpty(edu.FieldOfStudy))
                        sb.AppendLine($"        <div class='timeline-desc'>Chuy\u00ean ng\u00e0nh: {HttpUtility.HtmlEncode(edu.FieldOfStudy)}</div>");
                    sb.AppendLine("      </div>");
                }
                sb.AppendLine("    </div>");
            }

            sb.AppendLine("  </div>");
            sb.AppendLine("</div>");

            return sb.ToString();
        }
    }
}
