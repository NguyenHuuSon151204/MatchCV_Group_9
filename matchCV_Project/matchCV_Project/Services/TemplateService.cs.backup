                    width: 100px;
                    height: 100px;
                    border-radius: 50%;
                    overflow: hidden;
                    margin-bottom: 16px;
                    border: 3px solid #555;
                }
                .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
