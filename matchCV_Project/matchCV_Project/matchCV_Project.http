@host = https://localhost:5001
@matchCV_Project_HostAddress = http://localhost:5185
@baseUrl = {{matchCV_Project_HostAddress}}/api/cv

### Variables
@userId = 1
@cvId = 1

###############################################
# RECRUITER ENDPOINTS
###############################################

###
# Recruiter - Get all jobs
GET {{host}}/api/recruiter/jobs

###
# Recruiter - Search jobs
GET {{host}}/api/recruiter/jobs?q=Backend

###
# Recruiter - Create job
POST {{host}}/api/recruiter/jobs
Content-Type: application/json

{
  "title": "Backend .NET Developer",
  "company": "Acme",
  "rawText": "We are looking for a .NET developer with SQL and Azure experience.",
  "userId": 2
}

###
# Recruiter - Get job by id
GET {{host}}/api/recruiter/jobs/1

###
# Recruiter - Get applications for a job
GET {{host}}/api/recruiter/jobs/1/applications

###
# Recruiter - Apply CV to job
POST {{host}}/api/recruiter/jobs/1/apply
Content-Type: application/json

{
  "documentId": 1,
  "candidateId": 3
}

###
# Recruiter - Update application status
PATCH {{host}}/api/recruiter/applications/1/status
Content-Type: application/json

{
  "status": "Reviewed"
}

###############################################
# LICENSE ENDPOINTS
###############################################

###
# License - Activate key
POST {{host}}/api/license/activate
Content-Type: application/json

{
  "key": "YOUR_LICENSE_KEY_PLAIN",
  "userId": 2
}

###
# License - Get current plan of user
GET {{host}}/api/license/me?userId=2

###############################################
# ADMIN ENDPOINTS
###############################################

###
# Admin - Summary dashboard
GET {{host}}/api/admin/summary

###
# Admin - Logs
GET {{host}}/api/admin/logs

###############################################
# CV MANAGEMENT ENDPOINTS
###############################################

###
# 1. CREATE CV - POST /api/cv
POST {{baseUrl}}
Content-Type: application/json

{
  "originalName": "My_Resume_2024.pdf",
  "templateId": 1
}

###
# 2. GET ALL CVs BY USER - GET /api/cv/user/{id}
GET {{baseUrl}}/user/{{userId}}
Accept: application/json

###
# 3. GET CV BY ID - GET /api/cv/{id}
GET {{baseUrl}}/{{cvId}}
Accept: application/json

###
# 4. UPDATE CV - PUT /api/cv/{id}
PUT {{baseUrl}}/{{cvId}}
Content-Type: application/json

{
  "originalName": "Updated_Resume_2024.pdf",
  "templateId": 2
}

###
# 5. UPLOAD CV FILE - POST /api/cv/{id}/upload
# Note: Sử dụng form-data với key "file" trong Postman hoặc REST Client
POST {{baseUrl}}/{{cvId}}/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test_cv.pdf"
Content-Type: application/pdf

< ./test_cv.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###
# 6. ANALYZE CV - POST /api/cv/{id}/analyze
POST {{baseUrl}}/{{cvId}}/analyze
Accept: application/json

###
# 7. DELETE CV - DELETE /api/cv/{id}
DELETE {{baseUrl}}/{{cvId}}
Accept: application/json

###############################################
# SWAGGER ENDPOINTS
###############################################

###
# 8. SWAGGER UI - GET /swagger
GET {{matchCV_Project_HostAddress}}/swagger
Accept: text/html

###
# 9. SWAGGER JSON - GET /swagger/v1/swagger.json
GET {{matchCV_Project_HostAddress}}/swagger/v1/swagger.json
Accept: application/json
